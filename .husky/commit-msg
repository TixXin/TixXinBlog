#!/bin/sh

# commit-msg：先剥离 AI 署名 trailer，再校验 subject 与 body。
# 规范见 AGENTS.md「版本控制与文档」：提交信息不添加 AI 署名或 emoji trailer。

# 剥离 AI 署名行（LC_ALL=C 按字节匹配，避免中文与 emoji 触发 illegal byte sequence）
stripped="$1.aistrip.$$"
LC_ALL=C grep -viE '^[[:space:]]*(Co-authored-by:[[:space:]]*(Claude|Happy|Cursor|cursoragent|Cursor Agent|Copilot|GitHub Copilot|Codex|OpenAI|ChatGPT|Gemini|Grok|Windsurf|Devin|Aider)([[:space:]]|<|$)|Co-authored-by:.*(noreply@anthropic\.com|yesreply@happy\.engineering|@cursor\.(com|sh)|copilot@github\.com|@openai\.com)|Claude-Session:|(.{0,8}[[:space:]])?Generated with \[?(Claude Code|Cursor)\]?|via \[?Happy\]?([[:space:]]*\(|$)|🤖)' "$1" > "$stripped" || true

# 去掉结尾多余空行后写回
LC_ALL=C awk '{lines[NR]=$0} END{last=0; for(i=1;i<=NR;i++) if(lines[i] ~ /[^[:space:]]/) last=i; for(i=1;i<=last;i++) print lines[i]}' "$stripped" > "$stripped.2" || cp "$stripped" "$stripped.2"
mv "$stripped.2" "$1"
rm -f "$stripped"

# 读取 commit message，过滤掉注释行和空行
msg=$(sed '/^#/d' "$1")
subject=$(echo "$msg" | head -n 1)
body=$(echo "$msg" | tail -n +3 | sed '/^$/d')

# 校验 subject 非空
if [ -z "$subject" ]; then
  echo "❌ commit 缺少 subject"
  exit 1
fi

# 校验 body 非空
if [ -z "$body" ]; then
  echo "❌ commit 缺少 body，请在 subject 后空一行写明本次变更的原因"
  echo "   格式："
  echo "   <type>(<scope>): <subject>"
  echo ""
  echo "   <body: 解释为什么做这次变更>"
  exit 1
fi
