# TixXinBlog 后端环境变量；用法见本目录 README.md
# 复制为 .env.local；密钥和初始管理员密码必须自行设置，不提交本机配置

NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://tixxin:tixxin@localhost:5432/tixxin_blog
# Windows 保留端口冲突时，同时调整 POSTGRES_PORT 和 DATABASE_URL 的端口。
POSTGRES_PORT=5432
MEDIA_DIRECTORY=./var/media
# 至少 32 个字符的随机签名密钥；令牌有效期由服务端认证常量管理
JWT_ACCESS_SECRET=<required>

# 仅初始化管理员时使用；密码至少 12 个字符，已有账号不会被默认值覆盖
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=<required>

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3456

# 持久运行任务默认关闭，补齐对应配置后再显式启用
OPERATIONS_WORKER_ENABLED=false
NOTIFICATION_EMAIL_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false

# 可选邮件通知：SMTP 用户与密码成对配置，站点地址应指向实际公开站点
# NOTIFICATION_SMTP_HOST=
# NOTIFICATION_SMTP_PORT=587
# NOTIFICATION_SMTP_SECURE=false
# NOTIFICATION_SMTP_USER=
# NOTIFICATION_SMTP_PASSWORD=
# NOTIFICATION_EMAIL_FROM=
# NOTIFICATION_EMAIL_TO=
# NOTIFICATION_SITE_URL=
# NOTIFICATION_MAIL_INTERVAL_SECONDS=60

# 可选周期备份：目录为绝对路径，OWNER_ID 为本备份归属的稳定 UUID v4
# BACKUP_DIRECTORY=
# BACKUP_OWNER_ID=
# BACKUP_EXECUTION_MODE=docker
# BACKUP_POSTGRES_CONTAINER=tixxin-blog-postgres
# BACKUP_INTERVAL_MINUTES=1440
# BACKUP_RETENTION_DAYS=30
# 可选异地接收地址与令牌成对配置；令牌至少 32 个字符
# BACKUP_TRANSFER_URL=
# BACKUP_TRANSFER_TOKEN=
