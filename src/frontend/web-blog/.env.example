# 前端本地开发配置：复制为同目录 .env，修改后重启 pnpm dev。
# 文章、评论及闪念使用本地 API；朋友圈始终读取真实 API。
NUXT_PUBLIC_USE_MOCK_REPO=false
NUXT_PUBLIC_POST_USE_MOCK_REPO=false
NUXT_API_BASE_URL=http://127.0.0.1:3000/api/v1
NUXT_PUBLIC_API_BASE_URL=/api/v1
# 订阅、canonical 和 sitemap 的本机公开地址；生产由部署环境注入正式地址。
NUXT_PUBLIC_SITE_URL=http://localhost:3456
