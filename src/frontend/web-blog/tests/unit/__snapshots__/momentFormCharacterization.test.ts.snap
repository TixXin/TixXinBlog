    <div class="moment-editor__row"><label>地点<input maxlength="160" value="江边"></label><label>设备<input maxlength="80" value="X100V"></label><label>心情<input maxlength="80" value="平静"></label></div><label>引用内容<select aria-label="动态引用类型" value="article">
        <option value="none">不引用</option>
        <option value="article">站内文章</option>
        <option value="link">外部链接</option>
      </select></label>
    <section><label>搜索公开文章<input type="search" aria-label="搜索引用文章" maxlength="200" placeholder="输入文章标题"></label>
      <p role="status">正在搜索文章…</p>
      <p role="alert">文章搜索失败</p><label>引用文章<select aria-label="引用文章" value="12">
          <option value="">请选择已公开文章</option>
          <option value="12">城市夜跑笔记</option>
          <option value="13">江边散步</option>
        </select></label>
    </section>
    <!--v-if-->
    <div class="moment-editor__row"><label>保存状态<select aria-label="动态保存状态" value="published">
          <option value="draft">草稿</option>
          <option value="published">已发布</option>
          <option value="archived">已归档</option>
        </select></label><label class="moment-editor__check"><input checked="" type="checkbox">置顶动态</label></div>
  </fieldset>
  <div class="moment-editor__actions">
    <div content="保存（Ctrl+S）"><button aria-busy="false" type="submit" aria-keyshortcuts="Control+S Meta+S">保存动态</button></div><button type="button">保存草稿</button><button type="button">发布动态</button><span>有尚未保存的输入</span>
  </div>
  <div>
    <div data-open="false"></div>
  </div>
</form>"
`;

