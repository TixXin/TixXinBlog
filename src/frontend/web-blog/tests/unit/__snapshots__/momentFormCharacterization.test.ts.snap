    <section class="moment-editor__media" aria-label="动态配图">
      <h2>配图（2 / 9）</h2><button type="button">选择或上传图片</button>
      <div class="moment-editor__images">
        <figure><img src="/a.webp" alt="动态配图 1"><button type="button" aria-label="移除配图 1">移除此配图</button></figure>
        <figure><img src="/b.webp" alt="动态配图 2"><button type="button" aria-label="移除配图 2">移除此配图</button></figure>
      </div>
