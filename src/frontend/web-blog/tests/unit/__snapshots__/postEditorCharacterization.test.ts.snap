exports[`已发布并有封面：撤回入口、封面预览与失败重试、地址标识 1`] = `
"<form class="post-editor">
  <div class="action-bar post-editor__actions" position="top">
    <admin-back-link-stub to="/admin/posts"></admin-back-link-stub><span>当前状态：已发布</span><span class="tooltip-trigger"><button aria-busy="false" type="submit" aria-keyshortcuts="Control+S Meta+S">保存修改</button></span>
    <!--teleport start-->
    <!--teleport end-->
    <!--v-if--><button type="button">撤回为草稿</button>
    <!--v-if--><a href="/articles/travel-notes">查看公开文章</a>
  </div>
  <p role="alert">保存失败</p><label>标题<input required="" maxlength="200"></label><label>摘要<textarea maxlength="1000" rows="2"></textarea></label><button type="button">从正文生成摘要</button>
  <admin-content-relations-stub selected="" candidates="" type="post" q="" page="1" error="" resolveerror="" pending="true" resolving="false" disabled="false"></admin-content-relations-stub>
  <div class="post-editor__fields"><label>专栏<input list="<id>" maxlength="64" required=""></label><datalist id="<id>">
      <option value="生活"></option>
      <option value="技术"></option>
    </datalist><label>类别<select>
        <option value="tech">技术</option>
        <option value="life">生活</option>
      </select></label><label>标签（逗号分隔）<input></label><label>阅读分钟<input type="number" min="1" max="300" aria-describedby="<id> <id>"></label></div>
  <div class="post-editor__reading">
    <p id="<id>" data-post-reading-stats="">正文字数：13（中文 11 字，英文及数字 2 词） · 建议阅读时间约 1 分钟</p><span class="tooltip-trigger"><button type="button" data-post-apply-reading-time="" aria-describedby="<id> <id>">按字数估算阅读时长</button></span>
    <!--teleport start-->
    <!--teleport end-->
    <p id="<id>" class="post-editor__hint">中文按字、英文及数字按词计数，不计代码块和图片。按中文约 350 字/分钟、英文及数字约 220 词/分钟估算；仅点击按钮时填入阅读分钟，可继续手动修改。</p>
    <p class="post-editor__hint" role="status" aria-label="阅读时长填入状态"></p>
  </div>
  <div class="post-editor__tag-options" aria-label="已有标签"><span>添加已有标签：</span><button type="button" disabled="">旅行</button><button type="button">读书</button></div><label>封面地址<input maxlength="2048" placeholder="https:// 或站内图片路径"></label><label>封面替代文本<input maxlength="300" placeholder="简要描述图片内容"></label><button type="button">从媒体库选择封面</button>
  <div class="post-editor__cover-preview"><img src="/cover.webp" alt="山路"></div>
  <section class="post-editor__seo" aria-label="文章地址与 SEO">
    <h2>文章地址与 SEO</h2><label>文章地址标识<input maxlength="120" pattern="[a-z][a-z0-9]*(-[a-z0-9]+)*" placeholder="例如 vue-reactivity，留空使用数字地址"></label>
    <p>以小写字母开头，只使用小写字母、数字和连字符。修改后旧地址仍指向本文。</p><label>SEO 标题<input maxlength="160" placeholder="留空使用文章标题"></label><label>SEO 描述<textarea maxlength="320" rows="3" placeholder="留空使用文章摘要或正文摘要"></textarea></label><label class="post-editor__check"><input type="checkbox">不让搜索引擎收录（文章仍公开可访问）</label>
    <div class="post-editor__search-preview" aria-label="搜索结果预览"><strong>山间旅行</strong>
      <p>http://localhost:3456/articles/travel-notes</p>
      <p>一次徒步</p>
    </div>
  </section><label class="post-editor__check"><input type="checkbox">置顶</label><button type="button">向正文插入媒体图片</button>
  <p id="<id>" class="post-editor__hint">可直接粘贴或拖入 JPEG、PNG、WebP 图片（单张不超过 8MB），将上传到媒体库并插入正文。</p>
  <p class="post-editor__hint" role="status" aria-label="正文图片上传状态"></p>
  <section class="post-outline" aria-label="正文章节导航"><label>正文章节（2） <select aria-label="选择正文章节">
        <option value="">选择要编辑的章节</option>
        <option value="0">出发 · 第 1 行</option>
        <option value="1">　抵达 · 第 5 行</option>
      </select></label><button type="button" data-post-outline-jump="" disabled=""><span class="iconify i-lucide:list-tree" aria-hidden="true"></span>定位章节</button>
    <p>定位后光标移到标题行首。</p>
  </section>
  <div class="post-editor__body"><label>Markdown 正文<textarea rows="24" maxlength="200000" aria-describedby="<id> <id>"></textarea></label>
    <section class="post-editor__preview" aria-label="文章预览">
      <h2>预览</h2>
      <article-markdown-stub content="# 出发

清晨的山路。

## 抵达

![](/missing.webp)

Hello world 你好"></article-markdown-stub>
    </section>
  </div>
</form>
<dialog class="post-editor__publish" aria-labelledby="publish-check-title" aria-describedby="publish-alt-description">
  <!-- 打开时焦点落在标题：内容超出高度时默认聚焦底部按钮会把标题和摘要滚出视口 -->
  <h2 id="publish-check-title" tabindex="-1" autofocus="">发布前检查</h2>
  <p>确认后将更新当前公开文章。</p>
  <dl>
    <dt>标题</dt>
    <dd>旅行记录</dd>
    <dt>文章地址</dt>
    <dd>http://localhost:3456/articles/travel-notes</dd>
    <dt>专栏与标签</dt>
    <dd>生活 · 旅行、摄影</dd>
    <dt>搜索收录</dt>
    <dd>不收录，但仍公开可访问</dd>
    <dt>有序关联</dt>
    <dd>未设置</dd>
    <dt>摘要</dt>
    <dd>一次徒步</dd>
  </dl>
  <!--v-if-->
  <!--v-if-->
  <section class="post-editor__alt-warnings" aria-labelledby="publish-alt-title">
    <h3 id="publish-alt-title">替代文本警告</h3>
    <p id="publish-alt-description">以下图片缺少替代文本，读屏用户可能无法理解图片内容。可返回补充，也可仍然发布。</p>
    <ul>
      <!--v-if-->
      <li>正文第 1 张图片（第 7 行）缺少替代文本。</li>
    </ul>
  </section>
  <p>地址唯一性会在保存时再次校验；保存失败不会清空输入。</p><button type="button">返回编辑</button><button type="button">仍然公开发布</button>
</dialog>
<admin-media-picker-stub open="false"></admin-media-picker-stub>"
`;

exports[`已发布并有封面：撤回入口、封面预览与失败重试、地址标识 2`] = `
"<div class="post-editor__cover-preview">
