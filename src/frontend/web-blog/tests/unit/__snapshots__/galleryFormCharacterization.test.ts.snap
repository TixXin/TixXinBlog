exports[`外链来源：非法地址、合法地址预览与加载状态 1`] = `
"<form class="gallery-editor">
  <header>
    <h1>新建照片作品</h1>
    <div to="/admin/gallery">返回图库管理</div>
    <!--v-if-->
  </header>
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <fieldset><label>作品标题<input aria-label="作品标题" required="" maxlength="160" value="雨后的街角"></label><label>作品说明<textarea aria-label="作品说明" maxlength="5000" rows="5" value=""></textarea></label>
    <section>
      <h2>作品图片</h2><label>图片来源<select aria-label="图片来源" value="external">
          <option value="media">媒体库图片</option>
          <option value="external">外部图片 URL</option>
        </select></label>
      <div><label>外部图片地址<input aria-label="外部图片地址" type="url" maxlength="2048" aria-invalid="true" aria-describedby="gallery-url-help gallery-url-error" value="ftp://example.com/a.webp"></label>
        <p id="gallery-url-help">填写完整 HTTP(S) 图片直链，可带查询参数。地址不会被服务器下载或检查；HTTPS 页面中的 HTTP 图片可能被浏览器阻止。</p>
        <p id="gallery-url-error" role="alert">请使用完整的 HTTP(S) 地址，不含空白、控制字符或反斜杠</p>
      </div>
      <p>切换来源会保留本次未提交输入；保存时仅使用选定来源。</p>
    </section>
    <div class="gallery-editor__row"><label>分类<input aria-label="作品分类" maxlength="40" placeholder="留空表示未分类" value=""></label><label>拍摄日期<div class="date-picker">
          <div class="input-field date-picker__field"><input class="date-picker__input" type="text" inputmode="numeric" autocomplete="off" spellcheck="false" role="combobox" aria-haspopup="dialog" aria-expanded="false" aria-label="拍摄日期" placeholder="选择日期" value=""><button type="button" class="date-picker__toggle" aria-label="打开日历"><span class="iconify i-lucide:calendar-days" aria-hidden="true"></span></button></div>
          <transition-stub name="date-picker-pop" appear="false" persisted="false" css="true">
            <!--v-if-->
          </transition-stub>
        </div></label></div>
    <p>拍摄日期、地点和器材均可留空，上传时间不会作为拍摄日期。</p>
    <div class="gallery-editor__row"><label>拍摄地点<input aria-label="拍摄地点" maxlength="160" value=""></label><label>拍摄器材<input aria-label="拍摄器材" maxlength="160" value=""></label></div>
    <div class="gallery-editor__row"><label>保存状态<select aria-label="作品保存状态" value="draft">
          <option value="draft">草稿</option>
          <option value="published">已公开</option>
          <option value="withdrawn">已撤回</option>
        </select></label><label>排序值（越大越靠前）<input aria-label="作品排序值" type="number" min="-1000000" max="1000000" step="1" value="0"></label></div>
    <div class="relations" selected="" candidates="" type="post" q="" page="1" pending="false" resolving="false" error="" resolveerror="" disabled="false" total="0"></div>
  </fieldset>
  <!--v-if-->
  <div>
    <div content="保存（Ctrl+S）"><button aria-busy="false" type="submit" aria-keyshortcuts="Control+S Meta+S" disabled="">保存作品</button></div><button type="button" disabled="">保存草稿</button><button type="button" disabled="">发布作品</button><span>尚未保存</span>
  </div>
  <div>
    <div data-open="false"></div>
  </div>
</form>"
`;

