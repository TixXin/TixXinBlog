exports[`编辑：恢复副本、旧副本、服务器版本、提示与已保存信息 1`] = `
"<form class="gallery-editor">
  <header>
    <h1>编辑照片作品</h1>
    <div to="/admin/gallery">返回图库管理</div><a href="/gallery?photo=36">查看公开作品</a>
  </header>
  <p role="alert">保存失败 <button type="button">重新读取</button></p>
  <p role="status">已保存</p>
  <p role="alert">本机保存失败 <button type="button">重试保存恢复副本</button></p>
  <section class="gallery-editor__notice" aria-label="作品恢复副本">
    <h2>发现本标签页未保存的输入</h2>
    <dl class="recovery-details">
      <dt>图片来源</dt>
      <dd>媒体库图片</dd>
      <dt>保留的外部图片地址</dt>
      <dd>未填写</dd>
      <dt>作品标题</dt>
      <dd>本机副本</dd>
      <dt>作品说明</dt>
      <dd>未填写</dd>
