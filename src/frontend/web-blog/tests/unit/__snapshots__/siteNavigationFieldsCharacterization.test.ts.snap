      <li class="site-nav-fields__row" data-row="quote-2"><label>第 3 条<input maxlength="120" required="" aria-invalid="false"></label>
        <!--v-if-->
        <div class="site-nav-fields__actions"><button type="button" data-move="up" aria-label="上移第 3 条一言">上移</button><button type="button" data-move="down" aria-label="下移第 3 条一言">下移</button><button type="button" aria-label="移除第 3 条一言">移除</button></div>
      </li>
      <li class="site-nav-fields__row" data-row="quote-3"><label>第 4 条<input maxlength="120" required="" aria-invalid="false"></label>
        <!--v-if-->
        <div class="site-nav-fields__actions"><button type="button" data-move="up" aria-label="上移第 4 条一言">上移</button><button type="button" data-move="down" aria-label="下移第 4 条一言">下移</button><button type="button" aria-label="移除第 4 条一言">移除</button></div>
      </li>
      <li class="site-nav-fields__row" data-row="quote-4"><label>第 5 条<input maxlength="120" required="" aria-invalid="false"></label>
        <!--v-if-->
        <div class="site-nav-fields__actions"><button type="button" data-move="up" aria-label="上移第 5 条一言">上移</button><button type="button" data-move="down" disabled="" aria-label="下移第 5 条一言">下移</button><button type="button" aria-label="移除第 5 条一言">移除</button></div>
      </li>
    </ol><button type="button">添加一言</button>
  </fieldset>
  <fieldset>
    <legend>备案与版权</legend><label>ICP 备案号（选填）<input maxlength="40" placeholder="如：京ICP备00000000号" aria-invalid="false"></label>
    <!--v-if--><label>备案链接（选填）<input type="url" inputmode="url" maxlength="300" placeholder="https://beian.miit.gov.cn/" aria-invalid="false" aria-describedby="<uid>-icp-hint"></label>
    <p id="<uid>-icp-hint">留空时链接到工信部备案查询；未填写备案号时页脚不展示备案信息。</p>
    <!--v-if--><label>版权文案（选填）<input maxlength="200" placeholder="© {year} {siteName}. All rights reserved." aria-invalid="false" aria-describedby="<uid>-copyright-hint"></label>
    <p id="<uid>-copyright-hint">留空使用默认格式“© <year> . All rights reserved.”；可用 {year} 表示当前年份、{siteName} 表示站点名称。</p>
    <!--v-if-->
    <p>页脚预览：© <year> 林间 · 京ICP备00000000号</p>
  </fieldset>
</fieldset>"
`;
