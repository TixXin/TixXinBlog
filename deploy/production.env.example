# 复制到仓库外的受控文件；只通过 --env-file 指定，不修改日常开发环境。
# RELEASE_PROJECT 一旦建立持久化卷就必须保持不变。
RELEASE_PROJECT=tixxin-production
RELEASE_VERSION=replace-with-git-sha
WEB_IMAGE_REPOSITORY=tixxin-blog-web
API_IMAGE_REPOSITORY=tixxin-blog-api
MIGRATION_IMAGE_REPOSITORY=tixxin-blog-migration
WORKER_IMAGE_REPOSITORY=tixxin-blog-worker
# 正式启用时建议换成经过验证的 tag@sha256:digest，记录镜像来源。
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
# 使用随机十六进制密码，避免 DATABASE_URL 中保留字符的编码歧义。
POSTGRES_PASSWORD=replace-with-random-hex
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
SITE_HOST=blog.example.com
SITE_URL=https://blog.example.com
# 默认只绑定本机；对外开放需另行授权后修改为对应接口地址。
HTTPS_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# 默认不启用 worker profile；环境开关和数据库通道暂停控制也必须显式解除。
OPERATIONS_WORKER_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_OWNER_ID=
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_DAYS=30
BACKUP_TRANSFER_URL=
BACKUP_TRANSFER_TOKEN=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_MAIL_INTERVAL_SECONDS=60
