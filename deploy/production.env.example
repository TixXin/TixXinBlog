# 复制到仓库外的受控文件；只通过 --env-file 指定，不修改日常开发环境。
# RELEASE_PROJECT 一旦建立持久化卷就必须保持不变。
RELEASE_PROJECT=tixxin-production
RELEASE_VERSION=replace-with-git-sha
WEB_IMAGE_REPOSITORY=tixxin-blog-web
API_IMAGE_REPOSITORY=tixxin-blog-api
MIGRATION_IMAGE_REPOSITORY=tixxin-blog-migration
WORKER_IMAGE_REPOSITORY=tixxin-blog-worker
# 使用 GitHub Release 的 GHCR 预构建镜像时改为下列仓库，RELEASE_VERSION 填去掉 v 的版本号（如 0.2.0），
# 并在发布前 docker pull 四个镜像；fork 仓库把 tixxin/tixxinblog 换成自己的 <所有者>/<仓库名>（全小写）。
# RELEASE_VERSION=0.2.0
# WEB_IMAGE_REPOSITORY=ghcr.io/tixxin/tixxinblog-web
# API_IMAGE_REPOSITORY=ghcr.io/tixxin/tixxinblog-api
# MIGRATION_IMAGE_REPOSITORY=ghcr.io/tixxin/tixxinblog-migration
# WORKER_IMAGE_REPOSITORY=ghcr.io/tixxin/tixxinblog-worker
# 正式启用时建议换成经过验证的 tag@sha256:digest，记录镜像来源。
POSTGRES_IMAGE=postgres:16-alpine
CADDY_IMAGE=caddy:2-alpine
# 使用随机十六进制密码，避免 DATABASE_URL 中保留字符的编码歧义。
POSTGRES_PASSWORD=replace-with-random-hex
JWT_ACCESS_SECRET=replace-with-random-secret-at-least-32-characters
SITE_HOST=blog.example.com
SITE_URL=https://blog.example.com
# 默认只绑定本机；对外开放需另行授权后修改为对应接口地址。
HTTPS_BIND_ADDRESS=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443

# 按实际容器网络填写，默认不信任任何转发头。避免填所有私网或 0.0.0.0/0。
# WEB 只信任 Caddy 的地址，API 只信任 Nuxt 的地址；可使用隔离代理网络的窄 CIDR。
WEB_TRUSTED_PROXY_CIDRS=
API_TRUSTED_PROXY_CIDRS=
# 留言展示的访客地区：由前置代理注入的头名称，未配置地理信息时留空即可
CLIENT_REGION_HEADER=x-client-region

# 访问统计默认关闭。PROVIDER 为 umami 或 plausible；SITE_ID 为 Umami website ID 或 Plausible 站点域名；
# SCRIPT_URL 为统计脚本完整地址，其 origin 会在运行时自动加入前端 CSP，详见 docs/deployment.md「访问统计」。
ANALYTICS_PROVIDER=
ANALYTICS_SITE_ID=
ANALYTICS_SCRIPT_URL=

# 默认不启用 worker profile；环境开关和数据库通道暂停控制也必须显式解除。
OPERATIONS_WORKER_ENABLED=false
BACKUP_SCHEDULE_ENABLED=false
BACKUP_OWNER_ID=
BACKUP_INTERVAL_MINUTES=1440
BACKUP_RETENTION_DAYS=30
BACKUP_TRANSFER_URL=
BACKUP_TRANSFER_TOKEN=
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_MAIL_INTERVAL_SECONDS=60
