# 依赖目录
node_modules/

# 构建产物
.nuxt/
.nuxt-production/
.output/
dist/
.dev-dist/
*.tsbuildinfo

# 环境变量
.env
.env.*
!.env.example

# 操作系统
.DS_Store
Thumbs.db

# 浏览器测试与本地验收产物（不按图片扩展名忽略，保留正式素材）
.playwright-mcp/
/.artifacts/
/docs/**/evidence/
/docs/git-validation/
test-results/
playwright-report/
blob-report/
coverage/

# 运行时媒体
**/var/media/
**/var/backups/

# 可选编辑器与代理工具（只在本机保留）
/.agents/
/.claude/
/.cursor/
/.vscode/
/.codex/
/.mcp.json
/CLAUDE.md
/.gitmessage

# Nuxt 测试模块自动生成的本机安装记录
/src/frontend/web-blog/.nuxtrc

# 本地完整数据备份与恢复资料
.backups/
